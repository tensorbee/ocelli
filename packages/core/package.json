    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dcmjs": "0.52.2"
  },
  "peerDependencies": {
    "@ocelli/wasm": "0.1.0"
  }
