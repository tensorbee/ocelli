#!/usr/bin/env bash
# Refuse a push whose head carries no verification evidence.
#
# This is the local half of deviation D-04. CI runs no GPU and no corpus, so
# the corpus gate lives here and in `/verify`. Pushing an unverified head means
# CI will refuse it anyway, later and more expensively.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # All-zero local sha means a branch deletion. Nothing to verify.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  if ! python3 scripts/verify_ledger.py check-commit "$local_sha"; then
    echo
    echo "Push refused. Run bin/ocelli.sh gate --all, then amend or commit"
    echo "again so the head carries its Ocelli-Verify trailer."
    exit 1
  fi
done

exit 0
